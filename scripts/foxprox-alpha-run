#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: $0 <config.json> -- <sandbox command> [args...]" >&2
  echo "runs a real rootless bwrap foxprox alpha sandbox via foxprox run-bwrap-alpha" >&2
}

if [[ $# -lt 3 ]]; then
  usage
  exit 64
fi
if [[ "$2" != "--" ]]; then
  usage
  exit 64
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v foxprox >/dev/null 2>&1 && command -v foxproxsetup >/dev/null 2>&1; then
  exec foxprox run-bwrap-alpha "$@"
fi

cargo build -p foxprox-cli --bins >/dev/null
export PATH="$repo_root/target/debug:$PATH"
exec "$repo_root/target/debug/foxprox" run-bwrap-alpha "$@"
